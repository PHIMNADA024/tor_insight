PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
MONGODB_URI= 
EMAIL_USER=
EMAIL_PASSWORD=
JWT_SECRET=some-long-random-string-at-least-32-chars-abc123xyz789
# Generate a separate random 32-byte key (64 hex characters) for TOTP secret encryption.
MFA_ENCRYPTION_KEY=replace-with-64-hex-characters-from-a-random-32-byte-key

# Vertex AI API key for TOR summaries (optional; summaries are off without it)
VERTEX_API_KEY=

# Scheduled syncs. Turn each on in ONE place only: the database is shared,
# so every running backend would sync again.
# BMA Open Contract, daily (old names ENABLE_SYNC_CRON / SYNC_CRON still work)
BMA_SYNC_ENABLED=false
BMA_SYNC_CRON=0 2 * * *
# National e-GP (gprocurement), every 20 min on weekdays during office hours
GPROCUREMENT_SYNC_ENABLED=false

# Bangkok e-GP sync schedule (turn on in one place only)
EGP_SYNC_ENABLED=false
EGP_SYNC_CRON=15 6 * * *

# Sign in with Google (optional; the Google button returns an error without these).
# Create an OAuth client ID of type "Web application" in Google Cloud and add the
# redirect URI below to its "Authorized redirect URIs".
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# HTTPS deployment (V4.1.2). In production the API refuses plain-HTTP requests
# to /api with 403 instead of redirecting; requests to localhost are always
# answered. REQUIRE_HTTPS=true/false overrides the default (on when
# NODE_ENV=production).
REQUIRE_HTTPS=
# Behind a reverse proxy or load balancer that terminates TLS, the number of
# proxy hops to trust (usually 1), so X-Forwarded-Proto and the client IP are
# read correctly. Leave empty when the app is reached directly.
TRUST_PROXY=
