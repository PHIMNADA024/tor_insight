PORT=4000
FRONTEND_ORIGIN=http://localhost:3000
MONGODB_URI= 
EMAIL_USER=
EMAIL_PASSWORD=
JWT_SECRET=some-long-random-string-at-least-32-chars-abc123xyz789

# Vertex AI API key for TOR summaries (optional; summaries are off without it)
VERTEX_API_KEY=

# Scheduled syncs. Turn each on in ONE place only: the database is shared,
# so every running backend would sync again.
# BMA Open Contract, daily (old names ENABLE_SYNC_CRON / SYNC_CRON still work)
BMA_SYNC_ENABLED=false
BMA_SYNC_CRON=0 2 * * *
# National e-GP (gprocurement), every 20 min on weekdays during office hours
GPROCUREMENT_SYNC_ENABLED=false
